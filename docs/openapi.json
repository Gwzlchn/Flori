  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "description": "Every non-2xx JSON body.",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "job_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Only on `conflict` when an existing job caused it."
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Collection": {
        "type": "object",
        "required": [
          "id",
          "domain_id",
          "name",
          "created"
        ],
        "properties": {
          "created": {
            "type": "string"
          },
          "domain_id": {
            "type": "integer",
            "format": "int64"
          },
          "feed": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Feed"
              }
            ]
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Domain": {
        "type": "object",
        "required": [
          "id",
          "name",
          "created"
        ],
        "properties": {
          "created": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string",
            "description": "Slug `^[a-z0-9][a-z0-9-]{0,47}$`; also the vault folder name. Immutable."
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "invalid_url",
          "invalid_name",
          "invalid_request",
          "not_found",
          "conflict",
          "upstream"
        ]
      },
      "Feed": {
        "type": "object",
        "required": [
          "kind",
          "url"
        ],
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/FeedKind"
          },
          "url": {
            "type": "string",
            "description": "Normalized URL."
          }
        }
      },
      "FeedItem": {
        "type": "object",
        "required": [
          "platform",
          "source_id",
          "title"
        ],
        "properties": {
          "duration_s": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "job": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/JobRef",
                "description": "Existing job for this item in this collection."
              }
            ]
          },
          "platform": {
            "$ref": "#/components/schemas/Platform"
          },
          "published": {
            "type": [
              "string",
              "null"
            ],
            "description": "`YYYY-MM-DD`."
          },
          "source_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "FeedKind": {
        "type": "string",
        "description": "Feed source kinds a collection can bind. Parsing normalizes the URL per kind.",
        "enum": [
          "bili_up",
          "bili_season",
          "bili_series",
          "bili_fav",
          "yt_channel",
          "yt_playlist"
        ]
      },
      "FeedList": {
        "type": "object",
        "required": [
          "title",
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FeedItem"
            }
          },
          "title": {
            "type": "string"
          }
        }
      },
      "FeedPick": {
        "type": "object",
        "required": [
          "platform",
          "source_id"
        ],
        "properties": {
          "platform": {
            "$ref": "#/components/schemas/Platform"
          },
          "source_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "FeedPicked": {
        "type": "object",
        "required": [
          "platform",
          "source_id",
          "job"
        ],
        "properties": {
          "job": {
            "$ref": "#/components/schemas/JobRef"
          },
          "platform": {
            "$ref": "#/components/schemas/Platform"
          },
          "source_id": {
            "type": "string"
          }
        }
      },
      "FeedSubmit": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FeedPick"
            },
            "description": "1-20 items."
          },
          "translate": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/TranslateMode"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "FeedSubmitResult": {
        "type": "object",
        "required": [
          "created",
          "skipped"
        ],
        "properties": {
          "created": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FeedPicked"
            }
          },
          "skipped": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FeedPicked"
            },
            "description": "Items that already had a job in this collection."
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "version"
        ],
        "properties": {
          "version": {
            "type": "string"
          }
        }
      },
      "JobDetail": {
        "type": "object",
        "required": [
          "job",
          "steps",
          "files",
          "assets",
          "preview_base",
          "job_url"
        ],
        "properties": {
          "assets": {
            "type": "object",
            "description": "Basename -> job-relative path, for rewriting `assets/<basename>` in previews.",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JobFile"
            },
            "description": "Merged `manifest.files` of finished steps; later steps win, as in publish."
          },
          "job": {
            "$ref": "#/components/schemas/JobSummary"
          },
          "job_url": {
            "type": "string"
          },
          "obsidian_uri": {
            "type": [
              "string",
              "null"
            ],
            "description": "`obsidian://open?vault=...&file=...` for the main note, after publish."
          },
          "preview_base": {
            "type": "string",
            "description": "Prefix for job-relative paths, `/api/jobs/{id}/files/`."
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StepInfo"
            }
          },
          "vault_path": {
            "type": [
              "string",
              "null"
            ],
            "description": "Path inside the vault after publish, e.g. `flori/ml/unsorted/2026-11-08-yt-abc/`."
          }
        }
      },
      "JobFile": {
        "type": "object",
        "required": [
          "name",
          "path"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Logical name from the manifest, e.g. `note`, `transcript`, `video`."
          },
          "path": {
            "type": "string",
            "description": "Path relative to the job directory."
          }
        }
      },
      "JobRef": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          }
        }
      },
      "JobStatus": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "succeeded",
          "failed",
          "canceled"
        ]
      },
      "JobSummary": {
        "type": "object",
        "required": [
          "id",
          "pipeline",
          "platform",
          "source_id",
          "url",
          "domain_id",
          "translate",
          "status",
          "created",
          "updated"
        ],
        "properties": {
          "collection_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "created": {
            "type": "string"
          },
          "current_exit_code": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Exit code of `current_step`; 30 means credentials expired."
          },
          "current_step": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/StepName",
                "description": "Step running now, or the step that failed or was canceled."
              }
            ]
          },
          "domain_id": {
            "type": "integer",
            "format": "int64"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "pipeline": {
            "$ref": "#/components/schemas/Pipeline"
          },
          "platform": {
            "$ref": "#/components/schemas/Platform"
          },
          "source_id": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "translate": {
            "$ref": "#/components/schemas/TranslateMode"
          },
          "updated": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "LogChunk": {
        "type": "object",
        "required": [
          "text",
          "next_offset"
        ],
        "properties": {
          "next_offset": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "description": "Whole UTF-8 lines starting at `offset`."
          }
        }
      },
      "NewCollection": {
        "type": "object",
        "required": [
          "domain_id",
          "name"
        ],
        "properties": {
          "domain_id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "NewDomain": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Pipeline": {
        "type": "string",
        "enum": [
          "video",
          "arxiv"
        ]
      },
      "Platform": {
        "type": "string",
        "enum": [
          "bilibili",
          "youtube",
          "arxiv"
        ]
      },
      "Punctuation": {
        "type": "object",
        "description": "From translate's `meta.punctuated`, `meta.sections` and `meta.kept_original`.",
        "required": [
          "sections",
          "kept_original"
        ],
        "properties": {
          "kept_original": {
            "type": "integer",
            "format": "int32",
            "description": "Sections whose reply changed more than punctuation; they keep the transcribed text.",
            "minimum": 0
          },
          "sections": {
            "type": "integer",
            "format": "int32",
            "description": "Sections with text sent to the AI.",
            "minimum": 0
          }
        }
      },
      "SetFeed": {
        "type": "object",
        "description": "`url: null` unbinds the feed.",
        "properties": {
          "url": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "StepInfo": {
        "type": "object",
        "required": [
          "seq",
          "name",
          "status",
          "attempts"
        ],
        "properties": {
          "attempts": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "error": {
            "type": [
              "string",
              "null"
            ],
            "description": "Last stderr line of the failed attempt."
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "30 means credentials expired."
          },
          "finished": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "$ref": "#/components/schemas/StepName"
          },
          "punctuation": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Punctuation",
                "description": "translate on a Chinese video, which gets punctuation instead of a translation."
              }
            ]
          },
          "seq": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "skipped_reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "`meta.skipped_reason` from the step manifest."
          },
          "started": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/StepStatus"
          }
        }
      },
      "StepName": {
        "type": "string",
        "enum": [
          "video-fetch",
          "video-transcribe",
          "video-frames",
          "arxiv-fetch",
          "arxiv-convert",
          "note",
          "translate",
          "publish"
        ]
      },
      "StepStatus": {
        "type": "string",
        "enum": [
          "pending",
          "running",
          "succeeded",
          "failed",
          "canceled"
        ]
      },
      "SubmitJob": {
        "type": "object",
        "required": [
          "url",
          "domain_id"
        ],
        "properties": {
          "collection_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "domain_id": {
            "type": "integer",
            "format": "int64"
          },
          "translate": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/TranslateMode",
                "description": "Default `auto`."
              }
            ]
          },
          "url": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "TranslateMode": {
        "type": "string",
        "enum": [
          "auto",
          "off"
        ]
      }
    }
  }
}
