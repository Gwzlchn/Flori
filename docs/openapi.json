  "components": {
    "schemas": {
      "AiCall": {
        "type": "object",
        "description": "The record of one AI CLI call. Its files hold untrusted transcript and model text.",
        "required": [
          "name",
          "attempt",
          "index",
          "files"
        ],
        "properties": {
          "attempt": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Job-relative paths, in this order where present: `.prompt.md`, `.call.json`,\n`.out.json` or `.out.txt`, `.err.txt`."
          },
          "index": {
            "type": "integer",
            "format": "int32",
            "description": "Counts the attempt's calls from 1.",
            "minimum": 0
          },
          "name": {
            "type": "string",
            "description": "`<step>-a<attempt>-<k>`."
          }
        }
      },
      "AiSpec": {
        "type": "object",
        "description": "Also what `GET /api/jobs/{id}` reports as the job's AI settings (contract 3).",
        "required": [
          "tool",
          "model_note",
          "model_translate",
          "cli_version"
        ],
        "properties": {
          "cli_version": {
            "type": "string"
          },
          "model_note": {
            "type": "string"
          },
          "model_translate": {
            "type": "string"
          },
          "tool": {
            "$ref": "#/components/schemas/AiTool"
          }
        },
        "additionalProperties": false
      },
      "AiTool": {
        "type": "string",
        "enum": [
          "claude",
          "codex"
        ]
      },
      "ApiError": {
        "type": "object",
        "description": "Every non-2xx JSON body.",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "job_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Only on `conflict` when an existing job caused it."
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Collection": {
        "type": "object",
        "required": [
          "id",
          "domain_id",
          "name",
          "created"
        ],
        "properties": {
          "created": {
            "type": "string"
          },
          "domain_id": {
            "type": "integer",
            "format": "int64"
          },
          "feed": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Feed"
              }
            ]
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Domain": {
        "type": "object",
        "required": [
          "id",
          "name",
          "created"
        ],
        "properties": {
          "created": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string",
            "description": "Slug `^[a-z0-9][a-z0-9-]{0,47}$`; also the vault folder name. Immutable."
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "invalid_url",
          "invalid_name",
          "invalid_request",
          "not_found",
          "conflict",
          "upstream"
        ]
      },
      "Feed": {
        "type": "object",
        "required": [
          "kind",
          "url"
        ],
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/FeedKind"
          },
          "url": {
            "type": "string",
            "description": "Normalized URL."
          }
        }
      },
      "FeedItem": {
        "type": "object",
        "required": [
          "platform",
          "source_id",
          "title"
        ],
        "properties": {
          "duration_s": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "job": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/JobRef",
                "description": "Existing job for this item in this collection."
              }
            ]
          },
          "platform": {
            "$ref": "#/components/schemas/Platform"
          },
          "published": {
            "type": [
              "string",
              "null"
            ],
            "description": "`YYYY-MM-DD`."
          },
          "source_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "FeedKind": {
        "type": "string",
        "description": "Feed source kinds a collection can bind. Parsing normalizes the URL per kind.",
        "enum": [
          "bili_up",
          "bili_season",
          "bili_series",
          "bili_fav",
          "yt_channel",
          "yt_playlist"
        ]
      },
      "FeedList": {
        "type": "object",
        "required": [
          "title",
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FeedItem"
            }
          },
          "title": {
            "type": "string"
          }
        }
      },
      "FeedPick": {
        "type": "object",
        "required": [
          "platform",
          "source_id"
        ],
        "properties": {
          "platform": {
            "$ref": "#/components/schemas/Platform"
          },
          "source_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "FeedPicked": {
        "type": "object",
        "required": [
          "platform",
          "source_id",
          "job"
        ],
        "properties": {
          "job": {
            "$ref": "#/components/schemas/JobRef"
          },
          "platform": {
            "$ref": "#/components/schemas/Platform"
          },
          "source_id": {
            "type": "string"
          }
        }
      },
      "FeedSubmit": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FeedPick"
            },
            "description": "1-20 items."
          },
          "translate": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/TranslateMode"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "FeedSubmitResult": {
        "type": "object",
        "required": [
          "created",
          "skipped"
        ],
        "properties": {
          "created": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FeedPicked"
            }
          },
          "skipped": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FeedPicked"
            },
            "description": "Items that already had a job in this collection."
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "version"
        ],
        "properties": {
          "version": {
            "type": "string"
          }
        }
      },
      "JobDetail": {
        "type": "object",
        "required": [
          "job",
          "steps",
          "files",
          "assets",
          "preview_base",
          "job_url"
        ],
        "properties": {
          "ai": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AiSpec",
                "description": "job.json's `ai`: the tool, the models for note and translate, and the CLI version."
              }
            ]
          },
          "assets": {
            "type": "object",
            "description": "Basename -> job-relative path, for rewriting `assets/<basename>` in previews.",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JobFile"
            },
            "description": "Merged `manifest.files` of finished steps; later steps win, as in publish."
          },
          "job": {
            "$ref": "#/components/schemas/JobSummary"
          },
          "job_url": {
            "type": "string"
          },
          "obsidian_uri": {
            "type": [
              "string",
              "null"
            ],
            "description": "`obsidian://open?vault=...&file=...` for the main note, after publish."
          },
          "preview_base": {
            "type": "string",
            "description": "Prefix for job-relative paths, `/api/jobs/{id}/files/`."
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StepInfo"
            }
          },
          "vault_path": {
            "type": [
              "string",
              "null"
            ],
            "description": "Path inside the vault after publish, e.g. `flori/ml/unsorted/2026-11-08-yt-abc/`."
          }
        }
      },
      "JobFile": {
        "type": "object",
        "required": [
          "name",
          "path"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Logical name from the manifest, e.g. `note`, `transcript`, `video`."
          },
          "path": {
            "type": "string",
            "description": "Path relative to the job directory."
          }
        }
      },
      "JobRef": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          }
        }
      },
      "JobStatus": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "succeeded",
          "failed",
          "canceled"
        ]
      },
      "JobSummary": {
        "type": "object",
        "required": [
          "id",
          "job_key",
          "pipeline",
          "platform",
          "source_id",
          "url",
          "domain_id",
          "translate",
          "status",
          "punctuates",
          "created",
          "updated"
        ],
        "properties": {
          "author": {
            "type": [
              "string",
              "null"
            ],
            "description": "Uploader of a video, or a paper's authors joined with \", \". This and the next three are\nset when publish succeeds; null before that, when the source did not say, and on jobs\npublished before these fields existed."
          },
          "collection_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "created": {
            "type": "string"
          },
          "current_exit_code": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Exit code of `current_step`; 30 means credentials expired."
          },
          "current_step": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/StepName",
                "description": "Step running now, or the step that failed or was canceled."
              }
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "The note's one-line summary, as in its frontmatter."
          },
          "domain_id": {
            "type": "integer",
            "format": "int64"
          },
          "duration_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Video length."
          },
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "Integer primary key: the `{id}` of every job endpoint and the name of `jobs/<id>/`."
          },
          "job_key": {
            "type": "string",
            "description": "String id written to the note's frontmatter as `job_id`:\n`<bili|yt|arxiv>-<source id>-<6 hex>`. Derived from platform, source_id and created, not\nstored; no endpoint takes it."
          },
          "pipeline": {
            "$ref": "#/components/schemas/Pipeline"
          },
          "platform": {
            "$ref": "#/components/schemas/Platform"
          },
          "published": {
            "type": [
              "string",
              "null"
            ],
            "description": "Date the source was published, `YYYY-MM-DD`."
          },
          "punctuates": {
            "type": "boolean",
            "description": "translate adds punctuation to a Chinese transcript instead of translating it, so pages\nname that step 加标点. Set by the job detail, and by the job list where `current_step` is\ntranslate, the one step name the list shows; false elsewhere."
          },
          "source_id": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "translate": {
            "$ref": "#/components/schemas/TranslateMode"
          },
          "updated": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "LogChunk": {
        "type": "object",
        "required": [
          "text",
          "next_offset"
        ],
        "properties": {
          "next_offset": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "description": "Whole UTF-8 lines starting at `offset`."
          }
        }
      },
      "MetaValue": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "integer",
            "format": "int64"
          },
          {
            "type": "number",
            "format": "double"
          },
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ],
        "description": "A manifest meta value: a JSON scalar or an array of strings."
      },
      "NewCollection": {
        "type": "object",
        "required": [
          "domain_id",
          "name"
        ],
        "properties": {
          "domain_id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "NewDomain": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Pipeline": {
        "type": "string",
        "enum": [
          "video",
          "arxiv"
        ]
      },
      "Platform": {
        "type": "string",
        "enum": [
          "bilibili",
          "youtube",
          "arxiv"
        ]
      },
      "Punctuation": {
        "type": "object",
        "description": "From translate's `meta.punctuated`, `meta.sections`, `meta.kept_original`, `meta.corrected`\nand `meta.reverted`. Jobs punctuated before corrections existed report 0 for the last two.",
        "required": [
          "sections",
          "kept_original",
          "corrected",
          "reverted"
        ],
        "properties": {
          "corrected": {
            "type": "integer",
            "format": "int32",
            "description": "Same-sounding ideographs the AI put in for misheard ones, counted as runs.",
            "minimum": 0
          },
          "kept_original": {
            "type": "integer",
            "format": "int32",
            "description": "Sections without the AI's punctuation; they keep the transcribed text.",
            "minimum": 0
          },
          "reverted": {
            "type": "integer",
            "format": "int32",
            "description": "Other changes of the AI, put back as transcribed, counted as runs.",
            "minimum": 0
          },
          "sections": {
            "type": "integer",
            "format": "int32",
            "description": "Sections with text sent to the AI.",
            "minimum": 0
          }
        }
      },
      "SetFeed": {
        "type": "object",
        "description": "`url: null` unbinds the feed.",
        "properties": {
          "url": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "StepInfo": {
        "type": "object",
        "required": [
          "seq",
          "name",
          "status",
          "attempts",
          "meta",
          "files",
          "ai_calls"
        ],
        "properties": {
          "ai_calls": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AiCall"
            },
            "description": "The step's AI CLI calls over all attempts, oldest first, from `ai/` (contract 1)."
          },
          "attempts": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "error": {
            "type": [
              "string",
              "null"
            ],
            "description": "Last stderr line of the failed attempt."
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "30 means credentials expired."
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JobFile"
            },
            "description": "The step's own `manifest.files`, before the merge into `JobDetail.files` where later\nsteps win."
          },
          "finished": {
            "type": [
              "string",
              "null"
            ]
          },
          "meta": {
            "type": "object",
            "description": "`manifest.meta` of a succeeded step as written; empty before it succeeds.",
            "additionalProperties": {
              "$ref": "#/components/schemas/MetaValue"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "name": {
            "$ref": "#/components/schemas/StepName"
          },
          "punctuation": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Punctuation",
                "description": "translate on a Chinese video, which gets punctuation instead of a translation."
              }
            ]
          },
          "seq": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "skipped_reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "`meta.skipped_reason` from the step manifest."
          },
          "started": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/StepStatus"
          }
        }
      },
      "StepName": {
        "type": "string",
        "enum": [
          "video-fetch",
          "video-transcribe",
          "video-frames",
          "arxiv-fetch",
          "arxiv-convert",
          "note",
          "translate",
          "publish"
        ]
      },
      "StepStatus": {
        "type": "string",
        "enum": [
          "pending",
          "running",
          "succeeded",
          "failed",
          "canceled"
        ]
      },
      "SubmitJob": {
        "type": "object",
        "required": [
          "url",
          "domain_id"
        ],
        "properties": {
          "collection_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "domain_id": {
            "type": "integer",
            "format": "int64"
          },
          "translate": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/TranslateMode",
                "description": "Default `auto`."
              }
            ]
          },
          "url": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "SystemInfo": {
        "type": "object",
        "description": "The running instance, read-only. Secrets are reported only as configured or not.",
        "required": [
          "version",
          "commit",
          "ai",
          "bili_login",
          "proxy",
          "ytdlp_version",
          "whisper_model",
          "data_dir",
          "vault_name",
          "domains",
          "collections",
          "notes",
          "weekly_goal",
          "weeks"
        ],
        "properties": {
          "ai": {
            "$ref": "#/components/schemas/AiSpec",
            "description": "What new jobs get: the configured tool and models and the CLI version probed at start\n(`unknown` when the CLI did not answer)."
          },
          "bili_login": {
            "type": "boolean",
            "description": "Whether a Bilibili SESSDATA is configured. Says nothing about it still being valid."
          },
          "collections": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "commit": {
            "type": "string",
            "description": "Short commit the binary was built from; `unknown` when the build did not say."
          },
          "data_dir": {
            "type": "string"
          },
          "disk_free_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Space left for the server's user on the filesystem of `data_dir`; null when unknown.",
            "minimum": 0
          },
          "disk_total_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "domains": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "notes": {
            "type": "integer",
            "format": "int32",
            "description": "Jobs that succeeded, i.e. published notes.",
            "minimum": 0
          },
          "proxy": {
            "type": "boolean"
          },
          "vault_name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "weekly_goal": {
            "type": "integer",
            "format": "int32",
            "description": "Submissions a week has to reach.",
            "minimum": 0
          },
          "weeks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WeekUse"
            },
            "description": "The current week and the three before it, newest first."
          },
          "whisper_model": {
            "type": "string",
            "description": "Last path component of the whisper model directory, e.g. `whisper-base`."
          },
          "ytdlp_version": {
            "type": "string",
            "description": "Probed at start; `unknown` when yt-dlp did not answer."
          }
        }
      },
      "TranslateMode": {
        "type": "string",
        "enum": [
          "auto",
          "off"
        ]
      },
      "WeekUse": {
        "type": "object",
        "required": [
          "start",
          "submitted",
          "met"
        ],
        "properties": {
          "met": {
            "type": "boolean",
            "description": "`submitted >= weekly_goal`. The current week may still get there."
          },
          "start": {
            "type": "string",
            "description": "Monday of the week, `YYYY-MM-DD` in +08:00."
          },
          "submitted": {
            "type": "integer",
            "format": "int32",
            "description": "Jobs created in the week, whatever became of them.",
            "minimum": 0
          }
        }
      }
    }
  }
}
