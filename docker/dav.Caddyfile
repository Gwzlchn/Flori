# TLS terminates here on the NAS. ECS only relays raw TCP:
#   ECS :8790 -> NAS :8790 (WebDAV), ECS :80 -> NAS :8791 (HTTP-01 for the IP cert).
# The ECS is not ICP-filed: TLS with a domain SNI gets reset on 443 and also on 8790, so
# clients use the IP address (no SNI) and its short-lived IP certificate. The web UI has its
# own port, ECS :8792 -> NAS :8792, because 8790 on the IP is WebDAV at the root.
# DAV_DOMAIN (A record -> ECS) and DAV_IP (the ECS public IP) come from the environment.
# Every public connection arrives from the ECS relay's private-network address. No rule may
# trust private ranges (remote_ip private_ranges and the like) or skip auth for them: that would
# let the whole internet in.
{
	http_port 8791
	https_port 8790
	# Clients connecting by IP send no SNI; pick the IP certificate for them.
	default_sni {$DAV_IP}
	order webdav before file_server
	servers {
		protocols h1 h2
		# The ECS relay has few connection slots; idle and slow clients give theirs back sooner.
		timeouts {
			read_header 10s
			idle 2m
		}
	}
}

(dav) {
	basic_auth {
		{env.DAV_USER} {env.DAV_HASH}
	}
	webdav {
		root /vault
	}
}

(dns_tls) {
	tls {
		issuer acme {
			dir {env.ACME_CA}
			dns alidns {
				access_key_id {env.ALIYUN_ACCESS_KEY_ID}
				access_key_secret {env.ALIYUN_ACCESS_KEY_SECRET}
			}
			resolvers 223.5.5.5 223.6.6.6
		}
	}
}

{$DAV_DOMAIN} {
	import dns_tls
	import dav
}

# Let's Encrypt issues IP certificates only under the 6-day shortlived profile.
(ip_tls) {
	tls {
		issuer acme {
			dir {env.ACME_CA}
			profile shortlived
			disable_tlsalpn_challenge
		}
	}
}

{$DAV_IP} {
	import ip_tls
	import dav
}

# The flori web UI from outside the LAN. flori checks Basic Auth, framing and cross-site
# requests itself; Caddy keeps the Host header, which that check compares with Origin.
{$DAV_IP}:8792 {
	import ip_tls
	# Access log on stderr, rotated by the json-file driver. Caddy masks Authorization in it;
	# never turn on log_credentials.
	log {
		output stderr
		format json
	}
	reverse_proxy flori:8780
}
