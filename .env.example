# Flori reads configuration only from the environment. Secrets live in .local/secrets.env
# and reach compose through --env-file; never put real values in this file.

FLORI_DATA_DIR=/data
FLORI_LISTEN=0.0.0.0:8780
FLORI_PUBLIC_URL=http://nas.lan:8780
FLORI_VAULT_NAME=flori
FLORI_STATIC_DIR=/app/web
FLORI_STEPS_DIR=/app/steps
FLORI_PROXY=http://host.docker.internal:11081
FLORI_AI_TOOL=claude
FLORI_AI_MODEL_NOTE=claude-opus-5-5
FLORI_AI_MODEL_TRANSLATE=claude-sonnet-5-5
# Defaults to $FLORI_DATA_DIR/models/whisper-base
FLORI_WHISPER_MODEL=

# Secrets, interpolated from .local/secrets.env
FLORI_WEB_USER=flori
FLORI_WEB_PASSWORD=
FLORI_BILI_SESSDATA=
# Optional fallback when the shared ~/.claude login is unusable
CLAUDE_CODE_OAUTH_TOKEN=
# Only when FLORI_AI_TOOL=codex
CODEX_HOME=
