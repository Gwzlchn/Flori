#!/usr/bin/env python3
"""Fake `codex exec ... --output-last-message FILE -` for tests. Same markers and log as
tests/fake/claude, plus FAKE_AUTH_REFRESH with codex's real refresh-token failure text; the reply
goes to the --output-last-message file. Each `--image FILE` is logged with its size, read while
the call runs."""

import json
import os
import sys
import time

args = sys.argv[1:]
model = args[args.index("--model") + 1] if "--model" in args else None
out_file = args[args.index("--output-last-message") + 1] if "--output-last-message" in args else None
prompt = sys.stdin.read()
images = [{"path": args[i + 1], "bytes": os.path.getsize(args[i + 1])}
          for i, arg in enumerate(args) if arg == "--image"]
with open(os.path.join(os.environ.get("HOME", "/tmp"), "fake-ai.log"), "a") as log:
    log.write(json.dumps({"tool": "codex", "model": model, "args": args, "bytes": len(prompt),
                          "images": images}) + "\n")

if out_file is None or model is None:
    print("fake codex: --model and --output-last-message are required", file=sys.stderr)
    sys.exit(2)
if "FAKE_HANG" in prompt:
    time.sleep(3600)
if "FAKE_AUTH_REFRESH" in prompt:
    print(json.dumps({"type": "error", "message": "Your access token could not be refreshed because "
                      "your refresh token was already used. Please log out and sign in again."}))
    sys.exit(1)
if "FAKE_AUTH" in prompt:
    print(json.dumps({"type": "error", "message": "401 Unauthorized: token expired"}))
    sys.exit(1)
if "FAKE_RATE_LIMIT" in prompt:
    print(json.dumps({"type": "error", "message": "429 Too Many Requests: rate limit reached"}))
    sys.exit(1)
if "FAKE_FAIL" in prompt:
    print(json.dumps({"type": "error", "message": "turn failed"}))
    sys.exit(1)
marker = "---FLORI-INPUT---\n"
invalid = "FAKE_INVALID" in prompt and (
    "FAKE_INVALID_ONCE" not in prompt or "---FLORI-FEEDBACK---" not in prompt)
text = "" if "FAKE_EMPTY" in prompt else "not json" if invalid else (
    prompt.rsplit(marker, 1)[1] if marker in prompt else "# 笔记\n\n这是假笔记。\n")
with open(out_file, "w") as fh:
    fh.write(text)
print(json.dumps({"type": "turn.completed"}))
