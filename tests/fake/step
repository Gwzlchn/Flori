#!/usr/bin/env bash
# Fake for `<self_exe> step <name> <job_dir> <out_dir>` in executor tests.
# <job_dir>/fake/<name> holds one token per attempt: an exit code, or "hang" to block with a
# child process until the group is killed. The last token repeats. No file means success.
set -u
if [ $# -ne 4 ] || [ "$1" != step ]; then
  echo "usage: step <name> <job_dir> <out_dir>" >&2
  exit 2
fi
name=$2 job_dir=$3 out_dir=$4
attempt=${FLORI_ATTEMPT:-1}
token=0
if [ -f "$job_dir/fake/$name" ]; then
  read -ra tokens <"$job_dir/fake/$name"
  if [ "${#tokens[@]}" -ge "$attempt" ]; then
    token=${tokens[attempt - 1]}
  else
    token=${tokens[-1]}
  fi
fi
echo "fake $name attempt $attempt token $token"
echo "fake $name stderr" >&2
case $token in
  hang)
    sleep 300 &
    wait
    ;;
  0)
    printf '{"title":null,"files":{},"assets":[],"meta":{}}\n' >"$out_dir/manifest.json"
    ;;
  *)
    exit "$token"
    ;;
esac
