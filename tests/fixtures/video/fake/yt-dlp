#!/bin/sh
# Fake yt-dlp for the video-fetch tests. Words in the video id pick the behavior; every call
# appends its arguments to fake-yt-dlp.log next to the step's out_dir, which it finds from the
# --print-to-file path of the video run and the subtitle template of the subtitle run.
args="$*"
# ignore-term: SIGTERM is ignored from before the log line on, so only the step can stop it.
case $args in *ignore-term*) trap '' TERM ;; esac
out= subs= template= meta= skip= url=
while [ $# -gt 0 ]; do
    case $1 in
        -o) case $2 in subtitle:*) subs=${2#subtitle:} ;; *) out=$2 ;; esac; shift ;;
        --print-to-file) template=$2 meta=$3; shift 2 ;;
        --skip-download) skip=1 ;;
        --) url=$2; shift ;;
    esac
    shift
done
[ -n "$out" ] && [ -n "$url" ] || { echo "ERROR: fake yt-dlp needs -o and -- <url>" >&2; exit 2; }
dir=$(dirname "$out")
printf '%s\n' "$args" >> "$(dirname "${meta:-$subs}")/../fake-yt-dlp.log"

cue() { printf '1\n00:00:00,000 --> 00:00:01,000\n%s\n' "$2" > "$dir/subtitle.$1.srt"; }
if [ -n "$skip" ]; then
    case $url in
        # Bilibili AI tracks: ai-zh shaped like the real one, translations in other languages.
        # yt-dlp writes only requested tracks; this fake writes ai-ja anyway. manual in the id
        # adds a manual Chinese track.
        *subs-ai*)
            cp "$(dirname "$0")/../bili-ai-zh.srt" "$dir/subtitle.ai-zh.srt"
            cue ai-en "During the 2017 stock market crash recovery"
            cue ai-ja "2017年の株式市場暴落の回復期に"
            case $url in *manual*) cue zh-CN 你好 ;; esac ;;
        *subs-ok*) cue en hello ;;
        # Manual tracks in several languages; lang-xx in the id sets the reported original.
        *subs-both*) cue en hello; cue zh-Hant 哈囉; cue zh-Hans 你好 ;;
        # TED-Ed: English and a community translation into traditional Chinese.
        *subs-tw*) cue en hello; cue zh-TW 這個標題 ;;
        *subs-zh*) cue zh-Hans 你好 ;;
        *subs-fr*) cue fr bonjour; cue en hello; cue zh-Hans 你好 ;;
        *subs-stall*) exec sleep 30 ;;
        *subs-killed*) kill -TERM $$ ;;
        *subs-404*)
            printf 'partial' > "$dir/video.en.vtt"
            echo "ERROR: Unable to download video subtitles for 'en': HTTP Error 404: Not Found" >&2
            exit 1 ;;
        *)
            echo "ERROR: Unable to download video subtitles for 'en': HTTP Error 429: Too Many Requests" >&2
            exit 1 ;;
    esac
    exit 0
fi

case $url in
    *live*) echo "[download] live does not pass filter (!is_live), skipping .."; exit 0 ;;
    *hang*|*ignore-term*) exec sleep 30 ;;
    *gone*)
        echo "ERROR: [youtube] gone: Video unavailable. This video has been removed by the uploader" >&2
        exit 1 ;;
esac

# One stream, downloaded the way yt-dlp downloads a single format: into <final>.part, continued
# from its size unless --no-continue, renamed when complete; a complete <final> is not
# downloaded again. The format is 136+140, or 18 with other bytes for fmt18 in the id. A fresh
# download with part-fail or part-killed in the id stops after 5 bytes, the way a dropped
# connection or the step timeout stops it.
#
# remux in the id: an flv format 80 that --remux-video turns into <final>, the way yt-dlp does:
# ffmpeg writes <final> in place, the flv goes after it, and an existing <final> counts as
# downloaded ahead of the flv. remux-killed: the remux right after a fresh download is cut off
# after 5 bytes, with the flv left, the way the step timeout stops it.
format=136+140 media='fake video'
case $url in *fmt18*) format=18 media='format 18 video' ;; *remux*) format=80 ;; esac
final=$(printf '%s' "$out" | sed "s/%(format_id)s/$format/; s/%(ext)s/mp4/")
case $args in *--no-continue*) rm -f "$final.part" ;; esac
flv=${final%.mp4}.flv
case $url in *remux*)
    if [ ! -f "$final" ]; then
        fresh=
        [ -f "$flv" ] || { printf '%s' "$media" > "$flv"; fresh=1; }
        case $fresh:$url in 1:*remux-killed*)
            printf '%s' "$media" | head -c 5 > "$final"
            kill -TERM $$ ;;
        esac
        printf '%s' "$media" > "$final"
        rm "$flv"
    fi ;;
esac
if [ ! -f "$final" ]; then
    have=0
    [ -f "$final.part" ] && have=$(wc -c < "$final.part")
    case $have:$url in
        0:*part-fail*|0:*part-killed*)
            printf '%s' "$media" | head -c 5 > "$final.part"
            case $url in *part-killed*) kill -TERM $$ ;; esac
            echo "ERROR: unable to download video data: The read operation timed out" >&2
            exit 1 ;;
    esac
    printf '%s' "$media" | tail -c +$((have + 1)) >> "$final.part"
    mv "$final.part" "$final"
fi
filepath=
case $template in *filepath*) filepath="\"filepath\": \"$final\", " ;; esac
case $url in
    *multi*) printf '{%s"title": "Course p01 lec01.mp4", "playlist_title": "Course", "uploader": "U", "duration": 12.5, "upload_date": "20240102"}' "$filepath" > "$meta" ;;
    *)
        # lang-xx in the id is the reported original language, printed only when asked for.
        language=
        case $url in *lang-en*) language=en ;; *lang-fr*) language=fr-FR ;; esac
        case $template in *language*) ;; *) language= ;; esac
        # The merged formats and tags, as yt-dlp reports them when the template asks.
        fields=
        case $template in *vcodec*)
            fields=', "width": 1280, "height": 720, "fps": 29.97, "vcodec": "avc1.64001F", "acodec": "mp4a.40.2", "tags": ["talk", " ted  ed ", "talk", ""]' ;;
        esac
        # title-tw: a traditional Chinese title; title-ja: a Japanese one with kanji.
        title=Title
        case $url in *title-tw*) title=這個標題說廣 ;; *title-ja*) title=東京の標題 ;; esac
        printf '{%s"title": "%s", "uploader": "U", "duration": 12.5, "upload_date": "20240102"%s%s}' \
            "$filepath" "$title" "${language:+, \"language\": \"$language\"}" "$fields" > "$meta" ;;
esac
