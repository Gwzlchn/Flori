{
  "type": "object",
  "additionalProperties": false,
  "required": ["package_id", "overview", "knowledge", "cross_section_links", "figures", "unresolved", "coverage_refs", "synthesis"],
  "properties": {
    "package_id": {"type": "string", "pattern": "^p[0-9]{3}[a-z]?$"},
    "overview": {"type": "string", "minLength": 1, "maxLength": 8000},
    "knowledge": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "topic", "claim", "explanation", "why_it_matters", "author_claim", "source_refs"],
        "properties": {
          "kind": {"enum": ["definition", "motivation", "assumption", "method", "result", "finding", "limitation", "context"]},
          "topic": {"type": "string", "minLength": 1, "maxLength": 500},
          "claim": {"type": "string", "minLength": 1, "maxLength": 4000},
          "explanation": {"type": "string", "minLength": 1, "maxLength": 8000},
          "why_it_matters": {"type": "string", "minLength": 1, "maxLength": 4000},
          "author_claim": {"type": "boolean"},
          "source_refs": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "cross_section_links": {
      "type": "array", "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["relation", "target_hint", "explanation", "source_refs"],
        "properties": {
          "relation": {"enum": ["defines", "depends_on", "supports", "qualifies", "contrasts", "applies_to", "needs_confirmation"]},
          "target_hint": {"type": "string", "minLength": 1, "maxLength": 1000},
          "explanation": {"type": "string", "minLength": 1, "maxLength": 4000},
          "source_refs": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "figures": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["figure_alias", "visual_analysis", "reading_guide", "supported_claim", "limits", "source_refs"],
        "properties": {
          "figure_alias": {"type": "string", "pattern": "^f[0-9]{2}$"},
          "visual_analysis": {"type": "string", "maxLength": 8000},
          "reading_guide": {"type": "string", "minLength": 1, "maxLength": 4000},
          "supported_claim": {"type": "string", "minLength": 1, "maxLength": 4000},
          "limits": {"type": "string", "minLength": 1, "maxLength": 4000},
          "source_refs": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "unresolved": {
      "type": "array", "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["question", "target_hint", "source_refs"],
        "properties": {
          "question": {"type": "string", "minLength": 1, "maxLength": 4000},
          "target_hint": {"type": "string", "minLength": 1, "maxLength": 1000},
          "source_refs": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "coverage_refs": {
      "type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true,
      "items": {"type": "string"}
    },
    "synthesis": {
      "type": "object", "additionalProperties": false,
      "required": ["analysis", "basis", "uncertainty"],
      "properties": {
        "analysis": {"type": "string", "minLength": 1, "maxLength": 8000},
        "basis": {"type": "string", "minLength": 1, "maxLength": 8000},
        "uncertainty": {"type": "string", "minLength": 1, "maxLength": 8000}
      }
    }
  }
}
