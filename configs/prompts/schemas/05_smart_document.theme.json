{
  "type": "object",
  "additionalProperties": false,
  "required": ["theme_id", "overview", "learning_sections", "cross_theme_links", "tensions", "limitations", "figure_guides", "coverage_refs", "synthesis"],
  "properties": {
    "theme_id": {"type": "string", "pattern": "^t[0-9]{2}$"},
    "overview": {"type": "string", "minLength": 1, "maxLength": 12000},
    "learning_sections": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["title", "purpose", "explanation", "knowledge_refs", "figure_refs"],
        "properties": {
          "title": {"type": "string", "minLength": 1, "maxLength": 500},
          "purpose": {"type": "string", "minLength": 1, "maxLength": 4000},
          "explanation": {"type": "string", "minLength": 1, "maxLength": 12000},
          "knowledge_refs": {"type": "array", "minItems": 1, "maxItems": 512, "uniqueItems": true, "items": {"type": "string"}},
          "figure_refs": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "cross_theme_links": {
      "type": "array", "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["target_hint", "relation", "explanation", "knowledge_refs"],
        "properties": {
          "target_hint": {"type": "string", "minLength": 1, "maxLength": 1000},
          "relation": {"enum": ["defines", "depends_on", "supports", "qualifies", "contrasts", "extends", "needs_confirmation"]},
          "explanation": {"type": "string", "minLength": 1, "maxLength": 8000},
          "knowledge_refs": {"type": "array", "minItems": 1, "maxItems": 512, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "tensions": {
      "type": "array", "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["question", "positions", "assessment", "knowledge_refs"],
        "properties": {
          "question": {"type": "string", "minLength": 1, "maxLength": 4000},
          "positions": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 4000}},
          "assessment": {"type": "string", "minLength": 1, "maxLength": 8000},
          "knowledge_refs": {"type": "array", "minItems": 1, "maxItems": 512, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "limitations": {
      "type": "array", "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["limitation", "consequence", "knowledge_refs"],
        "properties": {
          "limitation": {"type": "string", "minLength": 1, "maxLength": 4000},
          "consequence": {"type": "string", "minLength": 1, "maxLength": 8000},
          "knowledge_refs": {"type": "array", "minItems": 1, "maxItems": 512, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "figure_guides": {
      "type": "array", "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["figure_ref", "placement_hint", "reading_guide", "supports", "limits", "knowledge_refs"],
        "properties": {
          "figure_ref": {"type": "string"},
          "placement_hint": {"type": "string", "minLength": 1, "maxLength": 1000},
          "reading_guide": {"type": "string", "minLength": 1, "maxLength": 8000},
          "supports": {"type": "string", "minLength": 1, "maxLength": 4000},
          "limits": {"type": "string", "minLength": 1, "maxLength": 4000},
          "knowledge_refs": {"type": "array", "minItems": 1, "maxItems": 512, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "coverage_refs": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"type": "string"}},
    "synthesis": {
      "type": "object", "additionalProperties": false,
      "required": ["analysis", "basis", "uncertainty"],
      "properties": {
        "analysis": {"type": "string", "minLength": 1, "maxLength": 12000},
        "basis": {"type": "string", "minLength": 1, "maxLength": 12000},
        "uncertainty": {"type": "string", "minLength": 1, "maxLength": 12000}
      }
    }
  }
}
